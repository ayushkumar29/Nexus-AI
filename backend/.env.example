# Core settings
APP_NAME="Nexus AI"
APP_ENV="development"
APP_VERSION="0.1.0"
DEBUG=True

# Server settings
HOST="127.0.0.1"
PORT=8000

# CORS settings (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="nexus_ai"
# Optional direct DATABASE_URL override:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres_secure_password@localhost:5432/nexus_ai"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication & Security
SECRET_KEY="generate-a-strong-random-secret-key-for-production-use"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Document Ingestion & Storage Settings (M3.1)
STORAGE_DIR="./storage/documents"
MAX_UPLOAD_SIZE_BYTES=20971520
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
